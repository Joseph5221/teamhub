@page "/"

<PageTitle>TeamHub | Unified Team Dashboard</PageTitle>

<div class="container mt-5 text-center">
    <h1 class="display-4 fw-bold">Welcome to TeamHub</h1>
    <p class="lead text-muted mb-4">
        Your modular dashboard for engineering, management, and DevOps visibility.
    </p>

    <div class="d-flex justify-content-center gap-3 mb-5">
        <a class="btn btn-primary btn-lg" href="/dashboard">Try the Demo</a>
        <a class="btn btn-outline-secondary btn-lg" href="/login">Sign In</a>
    </div>

    <h3 class="fw-semibold mb-4">Integrate your team's tools</h3>

    <div class="row justify-content-center">
        <div class="col-md-2 m-2 p-3 border rounded shadow-sm">
            <h6 class="fw-semibold mb-2">GitHub</h6>
            <p>Track pull requests & commits</p>
        </div>
        <div class="col-md-2 m-2 p-3 border rounded shadow-sm">
            <h6 class="fw-semibold mb-2">Jira</h6>
            <p>Visualize sprint progress</p>
        </div>
        <div class="col-md-2 m-2 p-3 border rounded shadow-sm">
            <h6 class="fw-semibold mb-2">Calendar</h6>
            <p>Sync upcoming meetings</p>
        </div>
        <div class="col-md-2 m-2 p-3 border rounded shadow-sm">
            <h6 class="fw-semibold mb-2">InfraWatch</h6>
            <p>Monitor infrastructure health</p>
        </div>
    </div>

    <footer class="mt-5 text-muted small">
        <p>© @DateTime.Now.Year TeamHub • Built with Blazor and .NET 8</p>
    </footer>
</div>
